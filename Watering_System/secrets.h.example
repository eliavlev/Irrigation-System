// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is git-ignored so credentials never get committed.
#pragma once

#define SECRET_WIFI_SSID "YourWiFiSSID"
#define SECRET_WIFI_PASS "YourWiFiPassword"

// MQTT broker (see server/README.md). Port 8883 = MQTT over TLS.
#define SECRET_MQTT_HOST "yourname.duckdns.org"
#define SECRET_MQTT_PORT 8883
#define SECRET_MQTT_USER "garden"
#define SECRET_MQTT_PASS "DevicePasswordFromSetupScript"

// Topic prefix becomes irrigation/<DEVICE_ID>/...
#define SECRET_DEVICE_ID "garden"
